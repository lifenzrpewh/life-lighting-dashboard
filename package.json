{
	"name": "life-lighting-dashboard",
	"version": "0.0.2",
	"private": true,
	"type": "module",
	"engines": {
		"node": "^22.20"
	},
	"scripts": {
		"build": "rimraf dist && tsc -p tsconfig.json",
		"build:app": "npm run build && tsc -p tsconfig.main.json && vite build",
		"build:plugin": "node scripts/build-plugin-xml.mjs",
		"dist:win": "npm run build:app && electron-builder --win --x64 --publish never",
		"dev": "node scripts/dev.mjs",
		"scan": "npm run build && node spikes/scan-exports.mjs",
		"start": "npm run build:app && electron .",
		"test": "npm run build && node --test \"test/*.test.js\" && npm run test:lua",
		"test:lua": "node scripts/run-lua-harness.mjs",
		"typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.web.json"
	},
	"dependencies": {
		"fast-xml-parser": "^4.5.0",
		"qrcode": "^1.5.4",
		"react": "^19.3.0",
		"react-dom": "^19.3.0"
	},
	"devDependencies": {
		"@tailwindcss/vite": "^4.3.3",
		"@types/qrcode": "^1.5.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.1",
		"electron": "^44.4.3",
		"electron-builder": "^26.15.3",
		"rimraf": "^6.0.1",
		"tailwindcss": "^4.3.3",
		"typescript": "^5.9.0",
		"vite": "^8.3.0"
	},
	"main": "dist/src/main/kiosk.js",
	"build": {
		"appId": "org.lifenz.lighting-dashboard",
		"directories": {
			"output": "release"
		},
		"files": [
			"dist/src/**/*.js",
			"dist/src/**/*.cjs",
			"dist/renderer/**/*",
			"package.json"
		],
		"asar": true,
		"npmRebuild": false,
		"win": {
			"target": [
				{
					"target": "nsis",
					"arch": [
						"x64"
					]
				}
			]
		},
		"nsis": {
			"oneClick": true,
			"perMachine": false,
			"runAfterFinish": true,
			"artifactName": "LIFE-Lighting-Dashboard-Setup-${version}.${ext}"
		}
	}
}
