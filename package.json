{
	"name": "paua",
	"productName": "Paua",
	"description": "Pāua: the booth dashboard for lighting and visuals at LIFE.",
	"version": "1.8.1",
	"private": true,
	"type": "module",
	"engines": {
		"node": "^22.20"
	},
	"scripts": {
		"build": "rimraf dist && tsc -p tsconfig.json",
		"build:app": "npm run build && tsc -p tsconfig.main.json && vite build",
		"build:plugin": "node scripts/build-plugin-xml.mjs",
		"dist:win": "npm run build:app && electron-builder --win --x64 --publish never",
		"dist:mac": "npm run build:app && electron-builder --mac --arm64 --publish never",
		"dev": "node scripts/dev.mjs",
		"scan": "npm run build && node spikes/scan-exports.mjs",
		"start": "npm run build:app && electron .",
		"test": "npm run build && node --test \"test/*.test.js\" && npm run test:lua",
		"test:lua": "node scripts/run-lua-harness.mjs",
		"look:check": "node scripts/sync-look.mjs src/renderer/look.css --check",
		"look:sync": "node scripts/sync-look.mjs src/renderer/look.css",
		"typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.web.json"
	},
	"dependencies": {
		"@fontsource-variable/archivo": "^5.3.0",
		"@napolab/texture-bridge": "0.15.0",
		"electron-updater": "^6.8.9",
		"fast-xml-parser": "^4.5.0",
		"koffi": "3.3.2",
		"lucide-react": "^1.52.0",
		"qrcode": "^1.5.4",
		"react": "^19.3.0",
		"react-dom": "^19.3.0"
	},
	"devDependencies": {
		"@tailwindcss/vite": "^4.3.3",
		"@types/qrcode": "^1.5.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.1",
		"electron": "^44.4.3",
		"electron-builder": "^26.15.3",
		"rimraf": "^6.0.1",
		"tailwindcss": "^4.3.3",
		"typescript": "^5.9.0",
		"vite": "^8.3.0"
	},
	"main": "dist/src/main/entry.js",
	"build": {
		"appId": "org.lifenz.lighting-dashboard",
		"directories": {
			"output": "release"
		},
		"files": [
			"dist/src/**/*.js",
			"dist/src/**/*.cjs",
			"dist/renderer/**/*",
			"package.json",
			"vendor/texture-bridge/**",
			"assets/icon.png"
		],
		"asar": true,
		"asarUnpack": [
			"node_modules/@napolab/texture-bridge*/**",
			"vendor/texture-bridge/**",
			"node_modules/koffi/**",
			"node_modules/@koromix/**"
		],
		"npmRebuild": false,
		"publish": [
			{
				"provider": "github",
				"owner": "lifenzrpewh",
				"repo": "life-lighting-dashboard",
				"releaseType": "release"
			}
		],
		"win": {
			"target": [
				{
					"target": "nsis",
					"arch": [
						"x64"
					]
				}
			],
			"icon": "build/icon.png"
		},
		"nsis": {
			"oneClick": true,
			"perMachine": false,
			"runAfterFinish": true,
			"artifactName": "Paua-Setup-${version}.${ext}",
			"shortcutName": "Pāua",
			"uninstallDisplayName": "Pāua"
		},
		"mac": {
			"target": [
				{
					"target": "dmg",
					"arch": [
						"arm64"
					]
				}
			],
			"category": "public.app-category.utilities",
			"identity": "-",
			"hardenedRuntime": false,
			"artifactName": "Paua-${version}-arm64.${ext}",
			"signIgnore": [
				"Syphon.framework"
			],
			"icon": "build/icon.png"
		},
		"dmg": {
			"title": "Paua ${version}"
		}
	}
}
