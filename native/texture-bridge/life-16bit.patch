+// LIFE patch: the format handed to Electron for a sender format. Electron's
+// importSharedTexture takes bgra (87), rgba (28) and rgbaf16 (10); anything
+// else is converted to BGRA8 on the GPU.
+static DWORD output_format(DWORD senderFormat) {
+    switch (senderFormat) {
+        case DXGI_FORMAT_B8G8R8A8_UNORM:
+        case DXGI_FORMAT_R8G8B8A8_UNORM:
+        case DXGI_FORMAT_R16G16B16A16_FLOAT:
+            return senderFormat;
+        default:
+            return DXGI_FORMAT_B8G8R8A8_UNORM;
+    }
+}
+
+// LIFE patch: a full-screen triangle, and a pixel shader that reads the one
+// sender texel under each output pixel. Same size in and out, so no sampler
+// and no filtering: the GPU's format conversion on write is the whole job.
+static const char kConvertHLSL[] =
+    "Texture2D src : register(t0);\n"
+    "float4 vs(uint id : SV_VertexID) : SV_Position {\n"
+    "    float2 uv = float2((id << 1) & 2, id & 2);\n"
+    "    return float4(uv * float2(2, -2) + float2(-1, 1), 0, 1);\n"
+    "}\n"
+    "float4 ps(float4 pos : SV_Position) : SV_Target {\n"
+    "    return src.Load(int3(pos.xy, 0));\n"
+    "}\n";
+
+static bool ensure_convert_shaders(SpoutReceiverBridge* bridge) {
+    if (bridge->convertVS && bridge->convertPS) return true;
+    ID3DBlob* vsBlob = nullptr;
+    ID3DBlob* psBlob = nullptr;
+    ID3DBlob* errors = nullptr;
+    HRESULT hr = D3DCompile(kConvertHLSL, sizeof(kConvertHLSL) - 1, "life_convert", nullptr, nullptr,
+                            "vs", "vs_5_0", 0, 0, &vsBlob, &errors);
+    if (SUCCEEDED(hr)) {
+        hr = D3DCompile(kConvertHLSL, sizeof(kConvertHLSL) - 1, "life_convert", nullptr, nullptr,
+                        "ps", "ps_5_0", 0, 0, &psBlob, &errors);
+    }
+    if (FAILED(hr)) {
+        fprintf(stderr, "[SpoutBridge] convert shaders did not compile hr=0x%08lx %s\n",
+                static_cast<unsigned long>(hr),
+                errors ? static_cast<const char*>(errors->GetBufferPointer()) : "");
+    } else {
+        hr = bridge->device->CreateVertexShader(vsBlob->GetBufferPointer(), vsBlob->GetBufferSize(),
+                                                nullptr, &bridge->convertVS);
+        if (SUCCEEDED(hr)) {
+            hr = bridge->device->CreatePixelShader(psBlob->GetBufferPointer(), psBlob->GetBufferSize(),
+                                                   nullptr, &bridge->convertPS);
+        }
+        if (FAILED(hr)) {
+            fprintf(stderr, "[SpoutBridge] convert shaders not created hr=0x%08lx\n",
+                    static_cast<unsigned long>(hr));
+        }
+    }
+    if (vsBlob) vsBlob->Release();
+    if (psBlob) psBlob->Release();
+    if (errors) errors->Release();
+    return bridge->convertVS && bridge->convertPS;
+}
+
+// LIFE patch: draw the sender's texture into ntStaging, converting its
+// format. Caller holds the sender's texture access.
+static bool convert_into_staging(SpoutReceiverBridge* bridge) {
+    if (!ensure_convert_shaders(bridge)) return false;
+    if (!bridge->senderSRV) {
+        HRESULT hr = bridge->device->CreateShaderResourceView(bridge->senderTexture, nullptr, &bridge->senderSRV);
+        if (FAILED(hr)) {
+            fprintf(stderr, "[SpoutBridge] sender SRV failed hr=0x%08lx fmt=%lu\n",
+                    static_cast<unsigned long>(hr), static_cast<unsigned long>(bridge->senderFormat));
+            bridge->senderSRV = nullptr;
+            return false;
+        }
+    }
+    if (!bridge->ntStagingRTV) {
+        HRESULT hr = bridge->device->CreateRenderTargetView(bridge->ntStaging, nullptr, &bridge->ntStagingRTV);
+        if (FAILED(hr)) {
+            fprintf(stderr, "[SpoutBridge] staging RTV failed hr=0x%08lx\n", static_cast<unsigned long>(hr));
+            bridge->ntStagingRTV = nullptr;
+            return false;
+        }
+    }
+    ID3D11DeviceContext* ctx = bridge->context;
+    D3D11_VIEWPORT vp = {};
+    vp.Width    = static_cast<float>(bridge->ntStagingWidth);
+    vp.Height   = static_cast<float>(bridge->ntStagingHeight);
+    vp.MaxDepth = 1.0f;
+    ctx->OMSetRenderTargets(1, &bridge->ntStagingRTV, nullptr);
+    ctx->RSSetViewports(1, &vp);
+    ctx->IASetInputLayout(nullptr);
+    ctx->IASetPrimitiveTopology(D3D11_PRIMITIVE_TOPOLOGY_TRIANGLELIST);
+    ctx->VSSetShader(bridge->convertVS, nullptr, 0);
+    ctx->PSSetShader(bridge->convertPS, nullptr, 0);
+    ctx->PSSetShaderResources(0, 1, &bridge->senderSRV);
+    ctx->Draw(3, 0);
+    // Unbind, so the sender texture is not left bound as an input.
+    ID3D11ShaderResourceView* noSRV = nullptr;
+    ctx->PSSetShaderResources(0, 1, &noSRV);
+    ctx->OMSetRenderTargets(0, nullptr, nullptr);
+    return true;
+}
