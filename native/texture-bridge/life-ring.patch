+static void submit_copy(SpoutReceiverBridge* bridge) {
+    if (!bridge->copyDone) {
+        D3D11_QUERY_DESC qd = {};
+        qd.Query = D3D11_QUERY_EVENT;
+        if (FAILED(bridge->device->CreateQuery(&qd, &bridge->copyDone))) bridge->copyDone = nullptr;
+    }
+    if (!bridge->copyDone) {
+        bridge->context->Flush();
+        return;
+    }
+    bridge->context->End(bridge->copyDone);
+    bridge->context->Flush();
+}
