+static void wait_copy(SpoutReceiverBridge* bridge) {
+    if (!bridge->copyDone) return;
+    LARGE_INTEGER freq, start, now;
+    QueryPerformanceFrequency(&freq);
+    QueryPerformanceCounter(&start);
